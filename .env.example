# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.

# REQUIRED by SEC EDGAR: a real name + email, e.g. "Zain Ahmed zain@example.com"
SEC_USER_AGENT=

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=

# Embeddings: "ollama" for local dev, "gemini" for the deployed API.
# An index is tied to the embedder that built it — switch => rebuild the index.
EMBEDDING_PROVIDER=ollama

# Ollama — leave as default if running Ollama locally on its standard port
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hosted embeddings (EMBEDDING_PROVIDER=gemini) — free key at https://atlas.nomic.ai
GEMINI_API_KEY=

# --- Live API (uvicorn edgariq.api.main:app) ---
# Comma-separated browser origins allowed to call it (your Vercel site)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
API_INDEX_PATH=deploy/indexes/NVDA.json.gz
API_RATE_LIMIT_PER_HOUR=6
API_DAILY_CAP=150
